# ---- Convex (this is OUR shared deployment) ----
# SDK / client URL (ConvexHttpClient, ConvexReactClient)
CONVEX_URL=https://reminiscent-anteater-318.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://reminiscent-anteater-318.convex.cloud

# HTTP actions (convex/http.ts) are served from .convex.site -- NOT .convex.cloud
CONVEX_SITE_URL=https://reminiscent-anteater-318.convex.site

# ---- Local-only keys (MCP server + web dashboard) ----
# Deepgram key for the browser listener + local TTS playback.
DEEPGRAM_API_KEY=

# ---- Keys that live in CONVEX env, NOT here ----
# Set these once with the Convex CLI, they are used inside Convex actions:
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set DEEPGRAM_API_KEY ...
#   npx convex env set FIRECRAWL_API_KEY fc-...
#   npx convex env set SLACK_BOT_TOKEN xoxb-...
